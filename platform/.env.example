APP_NAME=Armaghan
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Development default: no external database credentials needed.
DB_CONNECTION=sqlite

# Laravel config should default to database_path('database.sqlite') when DB_DATABASE is absent.
# When MySQL is introduced later, configure these only in environment/server secrets:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=armaghan
# DB_USERNAME=
# DB_PASSWORD=
