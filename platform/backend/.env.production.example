APP_NAME=Armaghan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.invalid

LOG_CHANNEL=stack
LOG_LEVEL=warning

# SQLite primary database. Use an absolute path outside public_html.
DB_CONNECTION=sqlite
DB_DATABASE=/home/CPANEL_USER/private/armaghan/database.sqlite
DB_FOREIGN_KEYS=true

# Consistent SQLite snapshots. Keep this private and outside public_html.
ARMAGHAN_SQLITE_BACKUP_PATH=/home/CPANEL_USER/private/armaghan/backups

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# MySQL/MariaDB is reserved for a later optional logical mirror/export.
# Do not put real MySQL credentials in this example or in Git.
